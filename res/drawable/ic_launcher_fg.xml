<?xml version="1.0" encoding="utf-8"?>
<!-- A boresight reticle whose horizontal crosshair becomes a signal trace: the two
     things this app does, in one mark. Drawn inside the adaptive-icon safe zone
     (radius 33 of a 108 viewport, centred on 54,54). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Reticle ring -->
    <path
        android:strokeColor="#4FD1C5"
        android:strokeWidth="3"
        android:fillColor="#00000000"
        android:pathData="M54,30 a24,24 0 1,0 0.01,0 Z" />

    <!-- Vertical crosshair arms, broken at the ring so the ring reads as a ring -->
    <path
        android:strokeColor="#4FD1C5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,23 L54,38" />
    <path
        android:strokeColor="#4FD1C5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,70 L54,85" />

    <!-- Horizontal arm, left: flat baseline running in from the edge -->
    <path
        android:strokeColor="#4FD1C5"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M23,54 L42,54" />

    <!-- The trace: a peak through the middle of the reticle -->
    <path
        android:strokeColor="#9BF0E6"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M42,54 L47,54 L51,41 L57,67 L62,46 L67,54 L85,54" />
</vector>
